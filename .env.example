# =============================================================================
# Copy to .env.local for local development, and paste the same keys into
# Vercel -> Project -> Settings -> Environment Variables for production.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ADMIN WHITELIST  <-- the only place admin access is defined
# -----------------------------------------------------------------------------
# Comma-separated. Case-insensitive. Whitespace is trimmed.
# Everyone listed has identical full-admin rights.
# An empty or unset value locks EVERYONE out (fails closed, by design).
ALLOWED_ADMIN_EMAILS="dosen@kampus.ac.id, asisten.lab@kampus.ac.id"

# -----------------------------------------------------------------------------
# 2. AUTH.JS (NextAuth v5)
# -----------------------------------------------------------------------------
# Generate with: npx auth secret     (or: openssl rand -base64 32)
# Also used to sign the short-lived CMS bearer token.
AUTH_SECRET=""

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Only needed if Vercel cannot infer the deployment URL.
# AUTH_URL="https://your-domain.vercel.app"

# -----------------------------------------------------------------------------
# 3. TINACMS — SELF-HOSTED BACKEND
# -----------------------------------------------------------------------------
# true  = local filesystem database, no auth, no GitHub writes  (npm run dev)
# false = real backend: Google auth + Redis index + GitHub commits
TINA_PUBLIC_IS_LOCAL=true

# GitHub repo that content is committed to.
# The token needs `repo` scope (classic PAT) or Contents:read+write (fine-grained).
GITHUB_OWNER=""
GITHUB_REPO="learn-digi-vercel"
GITHUB_BRANCH="main"
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Upstash Redis, added via Vercel -> Storage -> Marketplace -> Upstash.
# Vercel injects these automatically once the integration is connected;
# copy them here for local `npm run dev:cms`.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# -----------------------------------------------------------------------------
# 4. OPTIONAL
# -----------------------------------------------------------------------------
# Reproduce production draft-hiding while running `next dev`.
# HIDE_DRAFTS=true

# Verbose Tina backend logging.
# DEBUG=true
